[Unit]
Description=snipetech: every snipetech service shares these limits and yields to everything else on the machine

[Slice]
# Low weight: under contention everything outside the slice (sshd, Caddy) comes first, so no CPU quota is needed.
# 7 Nov 19:39 the 4 Nov quota (2 cores, set to share the box with a trading server) still held on the 6-core machine:
# it throttled 15 % of periods while nothing else ran there. Set on the server with systemctl set-property as well.
CPUWeight=20
IOWeight=20
# Memory, page cache included (the 40 GB database is read from it), as shares of the machine so a resize needs no
# edit here: 13 and 14 GB on the 16 GB machine, 26 and 28 GB on a 32 GB one. 7 Nov the 2600M/3G limits were hit
# 4 million times and the recorder waited on the disk 9 % of its time; 10 Nov the 12G limit was hit 166,000 times in
# an hour and the machine froze once. After a resize: `systemctl set-property snipetech.slice MemoryHigh=80%
# MemoryMax=88%` as root, or the owner's `deploy/setup.sh` run.
MemoryHigh=80%
MemoryMax=88%
# While another job on the machine has memory to give back, the kernel takes it there before it takes the slice's
# below this share. 11 Nov 07:12 UTC Ubuntu's update job grew to 15.6 GB and the slice's page cache went from 26 GB
# to 0.3 GB: the recorder sat 667 s in one flush, reading every database page from the disk.
MemoryLow=50%
