[Unit]
Description=snipetech remote operations (signed requests only; see src/snipetech/ops.py)
After=network-online.target

[Service]
Slice=snipetech.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
User=@USER@
EnvironmentFile=/etc/snipetech/env
WorkingDirectory=@DATA@
ExecStart=@REPO@/.venv/bin/snipetech --db @DATA@/snipetech.db ops-serve --host 127.0.0.1 --port 8788 --data @DATA@
Restart=always
RestartSec=3
# A deploy restarts this service: its jobs go on to their end, as the operator's do (they keep the old code),
# and `remote kill` still reaches them by id. Under KillMode=mixed a deploy killed them (7 Nov 07:44).
KillMode=process

[Install]
WantedBy=multi-user.target
