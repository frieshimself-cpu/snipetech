[Unit]
Description=snipetech remote operations (signed requests only; see src/snipetech/ops.py)
After=network-online.target

[Service]
User=@USER@
EnvironmentFile=/etc/snipetech/env
WorkingDirectory=@DATA@
ExecStart=@REPO@/.venv/bin/snipetech --db @DATA@/snipetech.db ops-serve --host 127.0.0.1 --port 8788 --data @DATA@
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
