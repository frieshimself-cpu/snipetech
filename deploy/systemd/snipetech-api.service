[Unit]
Description=snipetech HTTP API (verdicts, rules, signals)
After=network-online.target

[Service]
Slice=snipetech.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
User=@USER@
EnvironmentFile=/etc/snipetech/env
ExecStart=@REPO@/.venv/bin/snipetech --db @DATA@/snipetech.db serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
