[Unit]
Description=snipetech strategist: at most one bounded change a day to [book] / [qualify], only after 20 new live round trips (learning loop, stage 6)
After=network-online.target

[Service]
Slice=snipetech.slice
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
Type=oneshot
User=@USER@
EnvironmentFile=/etc/snipetech/env
WorkingDirectory=@DATA@
ExecStart=@REPO@/.venv/bin/snipetech --db @DATA@/snipetech.db strategist run
TimeoutStartSec=20m
