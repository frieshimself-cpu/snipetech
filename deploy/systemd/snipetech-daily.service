[Unit]
Description=snipetech daily: the history of the best deployers, and what each kind of market event is worth as a buy signal
After=network-online.target

[Service]
Slice=snipetech.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Type=oneshot
User=@USER@
EnvironmentFile=/etc/snipetech/env
WorkingDirectory=@DATA@
ExecStart=/bin/sh -c '\
  D=@DATA@/reports/$(date -u +%%Y-%%m-%%d); mkdir -p $D; S=@REPO@/.venv/bin/snipetech; DB="--db @DATA@/snipetech.db"; \
  $S $DB profitable-devs --backfill 20 > $D/profitable-devs.txt 2>&1; \
  $S $DB events edge > $D/event-edge.txt 2>&1'
TimeoutStartSec=6h
