[Unit]
Description=snipetech daily: refresh verdicts, one strategy lab at the +1 landing (the qualify timer runs the +6 by-wallet lab), plan OKTech changes
After=network-online.target

[Service]
Slice=snipetech.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Type=oneshot
User=@USER@
EnvironmentFile=/etc/snipetech/env
WorkingDirectory=@DATA@
ExecStart=/bin/sh -c '\
  D=@DATA@/reports/$(date -u +%%Y-%%m-%%d); mkdir -p $D; S=@REPO@/.venv/bin/snipetech; DB="--db @DATA@/snipetech.db"; \
  $S $DB profitable-devs --backfill 20 > $D/profitable-devs.txt 2>&1; \
  $S $DB follow --kols --days 1 > $D/follow-kols.txt 2>&1; \
  $S $DB lab --latency 0 --position +1 > $D/lab-0-+1.txt 2>&1; \
  $S $DB oktech plan > $D/oktech-plan.txt 2>&1'
TimeoutStartSec=6h
